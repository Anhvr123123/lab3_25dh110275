@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <script src="~/Scripts/myJVS/BT4.js"></script>
    <meta name="viewport" content="width=device-width" />
    <title>Bài tập 4 - To-Do List</title>
    <!DOCTYPE html>
    <head>
        <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: Arial, Helvetica, sans-serif;
            }

            body {
                background-color: #eeeeee;
                display: flex;
                justify-content: center;
                align-items: flex-start;
                padding-top: 50px;
                min-height: 100vh;
            }

            /* Khung chứa ứng dụng To-Do List */
            .todo-card {
                width: 400px;
                background-color: #ffffff;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            }

            /* Thanh nhập liệu trên cùng */
            .header-box {
                display: flex;
                background-color: #34495e;
                height: 55px;
            }

                .header-box input {
                    flex: 1;
                    background: transparent;
                    border: none;
                    outline: none;
                    padding: 0 20px;
                    color: #ffffff;
                    font-size: 18px;
                }

                    .header-box input::placeholder {
                        color: #7f8c8d;
                    }

                .header-box button {
                    width: 60px;
                    background-color: #1abc9c;
                    border: none;
                    color: #ffffff;
                    font-size: 28px;
                    cursor: pointer;
                    transition: background-color 0.2s;
                }

                    .header-box button:hover {
                        background-color: #16a085;
                    }

            /* Danh sách việc cần làm */
            .todo-list {
                list-style: none;
            }

            .todo-item {
                display: flex;
                align-items: center;
                padding: 15px 20px;
                border-bottom: 1px solid #e2e8f0;
                font-size: 18px;
                font-weight: bold;
                color: #000000;
                user-select: none;
            }

                .todo-item:last-child {
                    border-bottom: none;
                }

                /* Custom Checkbox */
                .todo-item input[type="checkbox"] {
                    width: 18px;
                    height: 18px;
                    margin-right: 15px;
                    cursor: pointer;
                    accent-color: #007bff;
                }

                .todo-item .task-text {
                    flex: 1;
                }

                /* Trạng thái khi công việc đã hoàn thành */
                .todo-item.completed .task-text {
                    text-decoration: line-through;
                    color: #bdc3c7;
                }

            /* Nút xóa công việc */
            .delete-btn {
                color: #e74c3c;
                cursor: pointer;
                font-size: 16px;
                display: none;
            }

            .todo-item:hover .delete-btn {
                display: block;
            }
        </style>
    </head>
    <body>

        <div class="todo-card">
            <!-- Input và Nút Thêm -->
            <div class="header-box">
                <input type="text" id="taskInput" placeholder="Enter a task" onkeypress="handleKeyPress(event)">
                <button onclick="addTask()">+</button>
            </div>

            <!-- Danh sách Task -->
            <ul id="todoList" class="todo-list">
                <!-- Dữ liệu mẫu ban đầu theo hình -->
                <li class="todo-item completed">
                    <input type="checkbox" checked onchange="toggleTask(this)">
                    <span class="task-text">Việc 1</span>
                    <span class="delete-btn" onclick="deleteTask(this)">✕</span>
                </li>
                <li class="todo-item">
                    <input type="checkbox" onchange="toggleTask(this)">
                    <span class="task-text">Việc 2</span>
                    <span class="delete-btn" onclick="deleteTask(this)">✕</span>
                </li>
                <li class="todo-item">
                    <input type="checkbox" onchange="toggleTask(this)">
                    <span class="task-text">Việc 3</span>
                    <span class="delete-btn" onclick="deleteTask(this)">✕</span>
                </li>
            </ul>
        </div>
    </body>
</>
