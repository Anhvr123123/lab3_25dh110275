@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VD1</title>
    @* JS có thể đặt ở đây
        
    *@
</head>
<body>
    @*
        
    JS có thể đặt ở đây *@
    <script type="text/javascript">
        var ten, tuoi;
        ten = prompt("Bạn tên là gì", "");
        tuoi = prompt("Bạn bao nhiêu tuổi", 20);
        document.write("Chào bạn <b>" + ten + "</b>");
        document.write("</br>");
        document.write("Tuổi của bạn là <u><i>" + tuoi + "</i></u>");
    </script>
    <div>
    
    </div>
    @* JS có thể đtặ ở đây*@
</body>
</html>
