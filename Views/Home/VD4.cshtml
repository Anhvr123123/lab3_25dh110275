@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VD4</title>
    <script type="text/javascript">
        function TihTien() {
            var dg = parseFloat(document.getElementById("dg").value);
            var sl = parseFloat(document.getElementById("sl").value);
            window.document.getElementById("tt").value = dg * sl;
        }

    </script>
</head>
<body>
    Nhập Số Lượng Và Đơn Giá
    <form>
        Đơn giá: <input type="number" id="dg" 
                        onkeyup="TinhTien();"
        onchange=TinhTien();"
                        /><br/>
        Số lượng: <input type="number" id="sl"
                         onkeyup="TinhTien();"
                         onchange="TinhTien();"
                         /><br />
        Thành Tiền: <input type="text" id="tt" />
    </form>
</body>
</html>
