@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VD3</title>
    <script type="text/javascript">
        function Homnay() {
            var d = new Date();
            var date = d.getDate();
            var month - d.getMonth() + 1;
            var year = d.getFullYear();
            alert("Hôm nay là ngày " + date + " tháng " + month + " năm " + year);
        }
    </script>
</head>
<body>
    <form>
    <input type="button" value="Hôm nay" onclick="Homnay();"/>
    </form>
</body>
</html>
